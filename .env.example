# ============================================================================
# CattleCapture — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# Na Vercel, configure estas variáveis em Project Settings > Environment Variables.
# ============================================================================

# ── Credenciais do Administrador (Login Direto & Auto-Provisionamento) ──────
# O sistema permite login imediato com estas credenciais e sincroniza o usuário
# com role="ADMIN" automaticamente no banco de dados.
ADMIN_EMAIL="admin@cattlecapture.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador CattleCapture"

# ── Autenticação NextAuth (JWT) ─────────────────────────────────────────────
AUTH_SECRET="cattle-capture-super-secret-jwt-key-2026-vercel-prod"
AUTH_TRUST_HOST="true"

# ── Banco de Dados PostgreSQL (Vercel Neon / Supabase / Local) ──────────────
DATA_POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/cattle_capture?schema=public"
DATA_POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/cattle_capture?schema=public"

# ── Armazenamento de Imagens (Vercel Blob Storage) ──────────────────────────
# Se BLOB_READ_WRITE_TOKEN ou (VERCEL_OIDC_TOKEN + BLOB_STORE_ID) estiverem
# configurados, as fotos são salvas no Vercel Blob. Caso contrário, o sistema
# utiliza fallback automático em Data URI otimizado no PostgreSQL.
BLOB_STORE_ID="store_zPZh2RYVHf5E0iyd"
BLOB_READ_WRITE_TOKEN=""
